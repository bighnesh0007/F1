# Copy this file to .env (same folder) and fill in what you need. .env is git-ignored:
# never commit it. Docker Compose, the API server and the web app all read it.

# --- Clerk (sign-in) ---------------------------------------------------------------
# From https://dashboard.clerk.com → your app → API keys.
# The publishable key is public (it ships to the browser); the secret key is not.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database ----------------------------------------------------------------------
# MongoDB Atlas connection string for user data. Leave empty to use the local
# MongoDB container. Example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=f1live

# --- Public address ------------------------------------------------------------------
# Where people open the app (used in calendar links).
PUBLIC_URL=http://localhost:3000

# --- F1 TV (optional) ----------------------------------------------------------------
# Unlocks live car GPS positions. See README.
F1_AUTH_TOKEN=

# --- Monitoring (optional) ----------------------------------------------------------
# Token for GET /api/health/metrics (response times, browser errors). Off when empty.
METRICS_TOKEN=

# --- Push notifications (optional) -------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Team radio transcripts (optional) ---------------------------------------------
# Any OpenAI-compatible transcription API (OpenAI, Groq, self-hosted faster-whisper).
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1

# --- AI race analyst (optional) ----------------------------------------------------
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# --- Android app (optional) --------------------------------------------------------
# For a Trusted Web Activity on Google Play (see README).
ANDROID_PACKAGE_NAME=
ANDROID_CERT_SHA256=
