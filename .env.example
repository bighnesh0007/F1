# Copy to .env and fill in what you need. Everything is optional.

# --- Database ---
# MongoDB Atlas connection string for user data. Leave empty to use the local
# MongoDB container. Example:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=f1live

# --- Public address ---
# Where people open the app. Must match the Google OAuth redirect URI below.
PUBLIC_URL=http://localhost:3000

# Random secret used to encrypt stored Google tokens. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=

# --- Google sign-in + Google Calendar (optional) ---
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
#   type: Web application
#   authorised redirect URI: <PUBLIC_URL>/api/auth/google/callback
# and enable the Google Calendar API for the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- F1 TV (optional) ---
# Unlocks live car GPS positions. See README.
F1_AUTH_TOKEN=
